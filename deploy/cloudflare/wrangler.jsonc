{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "semantic-rails",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-10",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../website",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "SemanticRailsContainer",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BACKEND",
        "class_name": "SemanticRailsContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SemanticRailsContainer"]
    }
  ],
  "ratelimits": [
    {
      "name": "METADATA_RATE_LIMITER",
      "namespace_id": "41001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "COMPUTE_RATE_LIMITER",
      "namespace_id": "41002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "vars": {
    "CANONICAL_HOST": "semantic-rails.com",
    "SEMANTIC_RAILS_CORS_ORIGINS": "https://semantic-rails.com,https://www.semantic-rails.com",
    "SEMANTIC_RAILS_PUBLIC_DEMO": "1"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
